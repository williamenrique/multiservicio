# =============================================================================
# CONFIGURACIÓN DEL SISTEMA MULTISERVICIO - EJEMPLO
# =============================================================================
# Copia este archivo a .env y ajusta los valores según tu entorno
# El archivo .env NO debe subirse a control de versiones (gitignore)

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=multiservicio_2.0

# -----------------------------------------------------------------------------
# SEGURIDAD / ENCRIPTACIÓN
# -----------------------------------------------------------------------------
SECRET_KEY=$multi$erc10
SECRET_IV=20242025

# -----------------------------------------------------------------------------
# URL Y ENTORNO
# -----------------------------------------------------------------------------
URLROOT=http://localhost/multiservicio/public_html
ENVIRONMENT=development
TIMEZONE=America/Caracas
SITENAME="Taller Pro"

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO (PHPMailer)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="Taller Pro"
MAIL_ADMIN=admin@taller.com

# -----------------------------------------------------------------------------
# WHATSAPP API - CONFIGURACIÓN PARA NOTIFICACIONES AUTOMÁTICAS
# -----------------------------------------------------------------------------
# 
# IMPORTANTE: Para que funcionen las notificaciones por WhatsApp, necesitas:
# 1. Un servidor Node.js corriendo con la API de WhatsApp (baileys, whatsapp-web.js, etc.)
# 2. El servidor debe exponer un endpoint POST que reciba { telefono, mensaje }
# 3. El número de teléfono debe estar en formato internacional SIN el signo +
#    Ejemplo: 584125181629 (Venezuela: código país 58 + número)
#
# ENDPOINT ESPERADO:
#   POST http://TU_SERVIDOR_WHATSAPP:3000/enviar-pedido
#   Body JSON: { "telefono": "584125181629", "mensaje": "Tu mensaje aquí" }
#   Response esperado: { "success": true, "messageId": "..." }
#
# EJEMPLOS DE SERVIDORES WHATSAPP:
# - baileys (WhatsApp Web API): https://github.com/WhiskeySockets/Baileys
# - whatsapp-web.js: https://github.com/pedroslopez/whatsapp-web.js
# - wwebjs: https://github.com/pedroslopez/whatsapp-web.js
#
# -----------------------------------------------------------------------------

# URL del servidor de WhatsApp (cambia localhost por la IP/dominio de tu servidor Node.js)
WHATSAPP_API_URL=http://localhost:3000/enviar-pedido

# Timeout en segundos para la petición HTTP al servidor WhatsApp
WHATSAPP_TIMEOUT=10

# Número de teléfono del ADMINISTRADOR que recibirá notificaciones de nuevos pedidos
# Formato: código de país + número, SIN el signo +, SIN espacios, SIN guiones
# Ejemplos:
#   Venezuela: 584125181629
#   Colombia: 573001234567
#   México: 5215512345678
#   España: 34612345678
WHATSAPP_ADMIN_PHONE=584125181629

# -----------------------------------------------------------------------------
# OPCIONAL: Configuración avanzada de WhatsApp
# -----------------------------------------------------------------------------
# Si tu servidor WhatsApp requiere autenticación (API Key, Bearer token, etc.)
# WHATSAPP_API_KEY=tu_api_key_aqui
# WHATSAPP_AUTH_HEADER=Authorization: Bearer tu_token_aqui